<style>
    .bg-wrapper {
  position: relative;
  min-height: 100vh;
}

.bg-wrapper::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url('/img/notebook.png') center/cover no-repeat;
  transform: scale(1);
  z-index: -1;
}

.btn-active {
  background-color: #b01e1e !important;
  border-color: #b01e1e !important;
  color: white !important;
}

.btn-active:hover {
  background-color: #b01e1e !important;
  border-color: #b01e1e !important;
  color: white !important;
}

.btn-active:focus,
.btn-active:active {
  background-color: #b01e1e !important;
  border-color: #b01e1e !important;
  color: white !important;
  box-shadow: none !important;
}

#editFlashcardBtn:focus,
#editFlashcardBtn:active,
#studyBtn:focus,
#studyBtn:active {
  background-color: #b01e1e !important;
  border-color: #b01e1e !important;
  box-shadow: none !important;
}

#editFlashcardBtn.btn-active:focus,
#editFlashcardBtn.btn-active:active,
#studyBtn.btn-active:focus,
#studyBtn.btn-active:active {
  background-color: #b01e1e !important;
  border-color: #b01e1e !important;
  color: white !important;
  box-shadow: none !important;
}

</style>

<div class="bg-wrapper">

<!-- Allows JS to access setId -->
<div id="setIdValue" data-setid="{{setId}}" data-set-name="{{setName}}" data-set-description="{{setDescription}}"></div>

<div class="text-center mt-3">
  <h1 class="fw-bold mb-0" style="color: #FFD447">{{setName}}</h1>
  <h5 class="fw-bold" style="color: #FFD447">{{setDescription}}</h5>
</div>

<div class="d-flex justify-content-center gap-2 container mt-2">
  <button id="editFlashcardBtn" type="button" class="btn btn-primary">Edit Flashcards</button>
  <button id="studyBtn" type="button" class="btn btn-primary">Study Flashcards</button>
</div>

<div class="d-flex justify-content-center gap-2" style="margin-top:10px;">
  <button id="editSetBtn" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#edit-set-modal">Edit Set</button>
  <button id="createBtn" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#flashcard-modal">
    Add Flashcard
  </button>
</div>

<!-- Edit set modal -->
<div class="modal" tabindex="-1" id="edit-set-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Set</h5>
      </div>

      <div class="modal-body">
        <form id="edit-set-form" action="/edit_set" method="POST">
          <input type="hidden" id="edit_set_set_id" name="set_id" value="{{setId}}">
          <div class="mb-3">
            <label for="edit_set_name">Set name</label>
            <textarea class="form-control" id="edit_set_name" name="set_name" maxlength="100" rows="2" required></textarea>
          </div>
          <div class="mb-3">
            <label for="edit_set_description">Set description</label>
            <textarea class="form-control" id="edit_set_description" name="set_description" maxlength="300" rows="3" required></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary" form="edit-set-form">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit flashcard modal -->
<div class="modal" tabindex="-1" id="edit-flashcard-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Flashcard</h5>
      </div>

      <div class="modal-body">
        <form id="edit-flashcard-form" action="/edit_flashcard" method="POST">
          <input type="hidden" id="edit_flashcard_card_id" name="card_id">
          <input type="hidden" id="edit_flashcard_set_id" name="set_id" value="{{setId}}">
          <div class="mb-3">
            <label for="edit_flashcard_front_text">Front text</label>
            <textarea class="form-control" id="edit_flashcard_front_text" name="front_text" maxlength="300" rows="3" required></textarea>
          </div>

          <div class="mb-3">
            <label for="edit_flashcard_back_text">Back text</label>
            <textarea class="form-control" id="edit_flashcard_back_text" name="back_text" maxlength="300" rows="3" required></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary" form="edit-flashcard-form">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Flashcard modal -->
<div class="modal" tabindex="-1" id="flashcard-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Flashcard</h5>
      </div>

      <div class="modal-body">
        <form id="flashcard-form" action="/create_flashcard" method="POST">
          <input type="hidden" id="flashcard_set_id" name="set_id" value="{{setId}}">
          <div class="mb-3">
            <label for="flashcard_front_text">Front text</label>
            <textarea class="form-control" id="flashcard_front_text" name="flashcard_front_text" maxlength="300" rows="3" placeholder="Enter description (max 300 characters)" required></textarea>
          </div>

          <div class="mb-3">
            <label for="flashcard_back_text">Back text</label>
            <textarea class="form-control" id="flashcard_back_text" name="flashcard_back_text" maxlength="300" rows="3" placeholder="Enter description (max 300 characters)" required></textarea>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary" form="flashcard-form">Save changes</button>
      </div>
    </div>
  </div>
</div>

<!-- holds all flashcards in edit mode -->
<div id="flashcardList" style="margin-left:20%; margin-right:20%; margin-top:20px;"></div>

<!-- carousel -->
<div id="flashcardCarousel" class="carousel slide" data-bs-interval="false" style="display:none;">
  <div class="carousel-inner" id="carouselInner"></div>

  <div class="text-center mt-3 d-flex justify-content-center gap-3">
    <button class="carousel-bottom-btn" data-bs-target="#flashcardCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-bottom-btn" data-bs-target="#flashcardCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>
</div>
</div>


<script>
async function loadExistingCards(setId) {
  try {
    const res = await fetch(`/sets/${setId}/cards`);
    const data = await res.json();

    if (!data.success) return;

    const cards = data.cards;

    cards.forEach(card => {
      addCardToList(card.front_text, card.back_text, card.card_id);
    });

    buildCarousel(cards);

  } catch (err) {
    console.error("Error loading cards:", err);
  }
}

function addCardToList(front, back, cardId) {
  const flashcardList = document.getElementById("flashcardList");

  const newCard = `
    <div class="card mb-3 flashcard-item" data-cardid="${cardId}">
      <div class="row align-items-center">
        <div class="col-md-5 col-12">
          <h5 class="card-title mb-0">${front}</h5>
        </div>
        <div class="col-md-5 col-12">
          <p class="card-text mb-0">${back}</p>
        </div>
        <div class="col-md-1 col-12">
          <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#edit-flashcard-modal" data-front="${front}" data-back="${back}" data-cardid="${cardId}">Edit</button>
        </div>
        <div class="col-md-1 col-12">
          <button type="button" class="delete-btn" style="background:none; border:none; padding:0;">
            <img src="/img/delete.png" width="100%" height="100%" style="border: 2px solid black; border-radius: 5px; padding: 2px">
          </button>
        </div>
      </div>
    </div>
  `;

  flashcardList.insertAdjacentHTML("beforeend", newCard);

  // Attach delete event
  const deleteButton = flashcardList.querySelector(`.flashcard-item[data-cardid="${cardId}"] .delete-btn`);
  deleteButton.addEventListener("click", async () => {
    try {
      await fetch(`/cards/${cardId}`, { method: "DELETE" });
      flashcardList.querySelector(`.flashcard-item[data-cardid="${cardId}"]`).remove();

      // Remove from carousel
      const carouselInner = document.getElementById("carouselInner");
      const carouselItem = carouselInner.querySelector(`.carousel-item[data-cardid="${cardId}"]`);
      if (carouselItem) carouselItem.remove();
    } catch (err) {
      console.error("Error deleting card:", err);
      alert("Could not delete flashcard.");
    }
  });
}

// this updates dynamically
function buildCarousel(cards) {
  const carouselInner = document.getElementById("carouselInner");
  carouselInner.innerHTML = "";

  if (!cards.length) {
    carouselInner.innerHTML = `
      <div class="carousel-item active">
        <div class="flashcard mx-auto">
          <div class="flashcard-inner">
            <div class="flashcard-front">No flashcards yet.</div>
            <div class="flashcard-back">Add some in Edit Mode!</div>
          </div>
        </div>
      </div>`;
    return;
  }

  cards.forEach((card, idx) => {
    const html = `
      <div class="carousel-item ${idx === 0 ? "active" : ""}" data-cardid="${card.card_id}">
        <div class="flashcard click-flip mx-auto">
          <div class="flashcard-inner">
            <div class="flashcard-front">${card.front_text}</div>
            <div class="flashcard-back">${card.back_text}</div>
          </div>
        </div>
      </div>
    `;
    carouselInner.insertAdjacentHTML("beforeend", html);
  });

  setTimeout(() => {
    document.querySelectorAll(".click-flip").forEach(card => {
      card.addEventListener("click", () => {
        card.classList.toggle("flipped");
      });
    });
  }, 50);
}

document.addEventListener("DOMContentLoaded", () => {
  const setIdElement = document.getElementById("setIdValue");
  const setId = setIdElement?.dataset.setid;

  if (setId) {
    loadExistingCards(setId);
  }

  const studyBtn = document.getElementById("studyBtn");
  const editFlashcardBtn = document.getElementById("editFlashcardBtn");
  const carousel = document.getElementById("flashcardCarousel");
  const flashBtn = document.getElementById("createBtn");
  const editSetBtn = document.getElementById("editSetBtn");
  const flashcardList = document.getElementById("flashcardList");
  const form = document.getElementById("flashcard-form");
  const flashcardModal = document.getElementById("flashcard-modal");
  const editFlashcardModal = document.getElementById('edit-flashcard-modal');
  const editSetModal = document.getElementById('edit-set-modal');

  // Study mode
  studyBtn.addEventListener("click", async () => {
    flashcardList.style.display = "none";
    carousel.style.display = "block";
    flashBtn.style.display = "none";
    editSetBtn.style.display = "none";

    studyBtn.classList.add("btn-active");
    editFlashcardBtn.classList.remove("btn-active");

    const setId = document.getElementById("setIdValue").dataset.setid;
    const res = await fetch(`/sets/${setId}/cards`);
    const data = await res.json();

    if (data.success) {
      buildCarousel(data.cards);
    }
  });

  // Edit mode
  editFlashcardBtn.addEventListener("click", () => {
    carousel.style.display = "none";
    flashcardList.style.display = "block";
    flashBtn.style.display = "block";
    editSetBtn.style.display = "block";

    editFlashcardBtn.classList.add("btn-active");
    studyBtn.classList.remove("btn-active");
  });

  // Submit flashcard
  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    const flashcard_front_text = document.getElementById("flashcard_front_text").value.trim();
    const flashcard_back_text = document.getElementById("flashcard_back_text").value.trim();
    const set_id = document.getElementById("flashcard_set_id").value;

    if (!flashcard_front_text || !flashcard_back_text) return;

    if (flashcard_back_text.length > 300) {
      alert("Description cannot exceed 300 characters.");
      return;
    }

    try {
      const response = await fetch("/create_flashcard", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ flashcard_front_text, flashcard_back_text, set_id })
      });

      const result = await response.json();

      if (!result.success) {
        alert("Error saving flashcard: " + result.message);
        return;
      }

      const cardId = result.flashcard.card_id;
      addCardToList(flashcard_front_text, flashcard_back_text, cardId);

      // Append to carousel
      const carouselInner = document.getElementById("carouselInner");
      const html = `
        <div class="carousel-item" data-cardid="${cardId}">
          <div class="flashcard click-flip mx-auto">
            <div class="flashcard-inner">
              <div class="flashcard-front">${flashcard_front_text}</div>
              <div class="flashcard-back">${flashcard_back_text}</div>
            </div>
          </div>
        </div>
      `;
      carouselInner.insertAdjacentHTML("beforeend", html);

      // Reattach flip events
      document.querySelectorAll(".click-flip").forEach(card => {
        card.addEventListener("click", () => card.classList.toggle("flipped"));
      });

      form.reset();

      const modal = bootstrap.Modal.getInstance(flashcardModal);
      modal.hide();

    } catch (err) {
      console.error("Error submitting flashcard:", err);
      alert("An error occurred while saving the flashcard.");
    }
  });

  editFlashcardModal.addEventListener('show.bs.modal', function (event) {
    // Get the button that triggered the modal
  const button = event.relatedTarget;
  
  // Extract data from data attributes
  const front = button.getAttribute('data-front');
  const back = button.getAttribute('data-back');
  const cardId = button.getAttribute('data-cardid');
  
  // Populate the form fields
  document.getElementById('edit_flashcard_front_text').value = front;
  document.getElementById('edit_flashcard_back_text').value = back;
  document.getElementById('edit_flashcard_card_id').value = cardId;
  });

  editFlashcardBtn.classList.add("btn-active");

  editSetModal.addEventListener('show.bs.modal', function (event) {
    const meta = document.getElementById('setIdValue');

    const set_name = meta.dataset.setName;
    const set_description = meta.dataset.setDescription;

    document.getElementById('edit_set_name').value = set_name;
    document.getElementById('edit_set_description').value = set_description;
  })
});
</script>
